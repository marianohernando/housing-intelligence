# Copy to .env and fill values. Never commit .env.
APP_ENV=local
LOG_LEVEL=INFO

POSTGRES_USER=housing
# Local Docker only (comments must be on their own line: make reads inline ones as part of the value)
POSTGRES_PASSWORD=housing
POSTGRES_DB=housing
POSTGRES_PORT=5440
# DATABASE_URL / TEST_DATABASE_URL default to the local Docker DB (see Makefile); set them only to override.
# DATABASE_URL=postgresql+psycopg://housing:housing@localhost:5440/housing

REDIS_PORT=6390
REDIS_URL=redis://localhost:6390/0

API_PORT=8010
WEB_PORT=3010

HI_DATA_DIR=./data

# Supabase remote (session pooler :5432, sslmode=require). Transaction pooler :6543 breaks Alembic.
# SUPABASE_DATABASE_URL=postgresql+psycopg://postgres.<ref>:<password>@aws-0-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require
# SUPABASE_DATAMAD_ACCESS_TOKEN lives in .claude/settings.local.json (gitignored), not here.

# Future
# OBJECT_STORAGE_URL=
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=

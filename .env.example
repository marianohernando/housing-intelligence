# Copy to .env and fill values. Never commit .env.
APP_ENV=local
LOG_LEVEL=INFO

POSTGRES_USER=housing
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=housing
POSTGRES_PORT=5440
DATABASE_URL=postgresql+psycopg://housing:CHANGE_ME@localhost:5440/housing
TEST_DATABASE_URL=postgresql+psycopg://housing:CHANGE_ME@localhost:5440/housing_test

REDIS_PORT=6390
REDIS_URL=redis://localhost:6390/0

API_PORT=8010
WEB_PORT=3010

HI_DATA_DIR=./data

# Supabase remote (session pooler :5432, sslmode=require). Transaction pooler :6543 breaks Alembic.
SUPABASE_DATABASE_URL=
# SUPABASE_DATAMAD_ACCESS_TOKEN lives in .claude/settings.local.json (gitignored), not here.


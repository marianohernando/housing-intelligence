{
  "$defs": {
    "CmPostcodeConceptPipeline": {
      "additionalProperties": false,
      "description": "Tables where the postcode is embedded in a free-text 'Concepto' column.",
      "properties": {
        "concept_column": {
          "default": "Concepto",
          "title": "Concept Column",
          "type": "string"
        },
        "csv": {
          "$ref": "#/$defs/CsvFormat"
        },
        "dataset_id": {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "title": "Dataset Id",
          "type": "string"
        },
        "kind": {
          "const": "cm_postcode_concept",
          "title": "Kind",
          "type": "string"
        },
        "metric_id": {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "title": "Metric Id",
          "type": "string"
        },
        "missing_markers": {
          "items": {
            "type": "string"
          },
          "title": "Missing Markers",
          "type": "array"
        },
        "period_column": {
          "default": "Año",
          "title": "Period Column",
          "type": "string"
        },
        "postcode_pattern": {
          "default": "c[oó]digo postal (\\d{5})",
          "title": "Postcode Pattern",
          "type": "string"
        },
        "resource_role": {
          "default": "primary",
          "title": "Resource Role",
          "type": "string"
        },
        "value_column": {
          "default": "Valor",
          "title": "Value Column",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "dataset_id",
        "metric_id"
      ],
      "title": "CmPostcodeConceptPipeline",
      "type": "object"
    },
    "CmStatTablePipeline": {
      "additionalProperties": false,
      "description": "Instituto de Estadística long tables: Año | Tipo territorio | Código | ... | Valor.",
      "properties": {
        "csv": {
          "$ref": "#/$defs/CsvFormat"
        },
        "dataset_id": {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "title": "Dataset Id",
          "type": "string"
        },
        "dimension_columns": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Dimension Columns",
          "type": "object"
        },
        "kind": {
          "const": "cm_stat_table",
          "title": "Kind",
          "type": "string"
        },
        "metric_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{2,95}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Metric Id"
        },
        "metric_split": {
          "anyOf": [
            {
              "$ref": "#/$defs/MetricSplit"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "missing_markers": {
          "items": {
            "type": "string"
          },
          "title": "Missing Markers",
          "type": "array"
        },
        "period_column": {
          "default": "Año",
          "title": "Period Column",
          "type": "string"
        },
        "period_min": {
          "anyOf": [
            {
              "maximum": 2100,
              "minimum": 1900,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Period Min"
        },
        "resource_role": {
          "default": "primary",
          "title": "Resource Role",
          "type": "string"
        },
        "territory_code_column": {
          "default": "Código territorio",
          "title": "Territory Code Column",
          "type": "string"
        },
        "territory_name_column": {
          "default": "Territorio",
          "title": "Territory Name Column",
          "type": "string"
        },
        "territory_type_column": {
          "default": "Tipo territorio",
          "title": "Territory Type Column",
          "type": "string"
        },
        "territory_types": {
          "additionalProperties": {
            "$ref": "#/$defs/TerritoryLevel"
          },
          "title": "Territory Types",
          "type": "object"
        },
        "unit_column": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "Unidad",
          "title": "Unit Column"
        },
        "value_column": {
          "default": "Valor",
          "title": "Value Column",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "dataset_id",
        "territory_types"
      ],
      "title": "CmStatTablePipeline",
      "type": "object"
    },
    "CsvFormat": {
      "additionalProperties": false,
      "properties": {
        "decimal": {
          "default": ".",
          "title": "Decimal",
          "type": "string"
        },
        "encodings": {
          "items": {
            "type": "string"
          },
          "title": "Encodings",
          "type": "array"
        },
        "separator": {
          "default": ";",
          "title": "Separator",
          "type": "string"
        }
      },
      "title": "CsvFormat",
      "type": "object"
    },
    "GtfsFeedPipeline": {
      "additionalProperties": false,
      "description": "Static GTFS feed -> one transport place per stop or parent station, with service levels.\n\nService is measured on one reference day: the median (by active trips) of the feed's\n`reference_weekday` dates inside its own validity window, so the result never depends on\nthe day the pipeline runs.",
      "properties": {
        "dataset_id": {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "title": "Dataset Id",
          "type": "string"
        },
        "expand_frequencies": {
          "default": true,
          "description": "False when frequencies.txt only annotates trips already listed one by one",
          "title": "Expand Frequencies",
          "type": "boolean"
        },
        "kind": {
          "const": "gtfs_feed",
          "title": "Kind",
          "type": "string"
        },
        "mode": {
          "description": "place subcategory, e.g. metro, emt",
          "pattern": "^[a-z_]+$",
          "title": "Mode",
          "type": "string"
        },
        "peak_end": {
          "default": "09:00",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
          "title": "Peak End",
          "type": "string"
        },
        "peak_start": {
          "default": "07:00",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
          "title": "Peak Start",
          "type": "string"
        },
        "reference_weekday": {
          "default": "tuesday",
          "enum": [
            "monday",
            "tuesday",
            "wednesday",
            "thursday",
            "friday",
            "saturday",
            "sunday"
          ],
          "title": "Reference Weekday",
          "type": "string"
        },
        "resource_role": {
          "default": "primary",
          "title": "Resource Role",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "dataset_id",
        "mode"
      ],
      "title": "GtfsFeedPipeline",
      "type": "object"
    },
    "MadridPadronPipeline": {
      "additionalProperties": false,
      "description": "Ayuntamiento de Madrid padrón: one row per census section and single year of age.\n\nDistricts get the CM census 5-year age bands plus their total, so ratios over this\npopulation compare like with like. The count columns (nationality x sex) are only summed.",
      "properties": {
        "age_column": {
          "title": "Age Column",
          "type": "string"
        },
        "census_metric_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{2,95}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Census Metric Id"
        },
        "count_columns": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Count Columns",
          "type": "array"
        },
        "csv": {
          "$ref": "#/$defs/CsvFormat"
        },
        "dataset_id": {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "title": "Dataset Id",
          "type": "string"
        },
        "district_column": {
          "title": "District Column",
          "type": "string"
        },
        "district_name_column": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "District Name Column"
        },
        "expected_districts": {
          "exclusiveMinimum": 0,
          "title": "Expected Districts",
          "type": "integer"
        },
        "kind": {
          "const": "madrid_padron",
          "title": "Kind",
          "type": "string"
        },
        "metric_id": {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "title": "Metric Id",
          "type": "string"
        },
        "municipio_ine": {
          "pattern": "^28\\d{3}$",
          "title": "Municipio Ine",
          "type": "string"
        },
        "period_column": {
          "title": "Period Column",
          "type": "string"
        },
        "resource_role": {
          "default": "primary",
          "title": "Resource Role",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "dataset_id",
        "metric_id",
        "municipio_ine",
        "district_column",
        "age_column",
        "count_columns",
        "period_column",
        "expected_districts"
      ],
      "title": "MadridPadronPipeline",
      "type": "object"
    },
    "MetricSplit": {
      "additionalProperties": false,
      "description": "One source column decides which metric a row belongs to (e.g. 'Medida').",
      "properties": {
        "column": {
          "title": "Column",
          "type": "string"
        },
        "metrics": {
          "additionalProperties": {
            "pattern": "^[a-z][a-z0-9_]{2,95}$",
            "type": "string"
          },
          "title": "Metrics",
          "type": "object"
        }
      },
      "required": [
        "column",
        "metrics"
      ],
      "title": "MetricSplit",
      "type": "object"
    },
    "OsmWalkNetworkPipeline": {
      "additionalProperties": false,
      "description": "OpenStreetMap extract -> undirected walkable street graph, kept in Silver only.\n\nA way is walkable when its `highway` value is listed or it explicitly allows people on foot;\n`foot=no`, or `access=no/private` without a foot permission, removes it. One-way rules apply\nto vehicles, so the graph is undirected. Only indicators computed on it reach the database.",
      "properties": {
        "access_denied": {
          "items": {
            "type": "string"
          },
          "title": "Access Denied",
          "type": "array"
        },
        "dataset_id": {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "title": "Dataset Id",
          "type": "string"
        },
        "foot_allowed": {
          "items": {
            "type": "string"
          },
          "title": "Foot Allowed",
          "type": "array"
        },
        "kind": {
          "const": "osm_walk_network",
          "title": "Kind",
          "type": "string"
        },
        "min_main_component_share": {
          "default": 0.9,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Min Main Component Share",
          "type": "number"
        },
        "min_total_km": {
          "description": "below this the extract is truncated",
          "exclusiveMinimum": 0,
          "title": "Min Total Km",
          "type": "number"
        },
        "resource_role": {
          "default": "primary",
          "title": "Resource Role",
          "type": "string"
        },
        "walkable_highways": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Walkable Highways",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "dataset_id",
        "walkable_highways",
        "min_total_km"
      ],
      "title": "OsmWalkNetworkPipeline",
      "type": "object"
    },
    "PlaceCategory": {
      "enum": [
        "education",
        "health",
        "social",
        "transport",
        "commerce",
        "culture",
        "sport",
        "administration",
        "green",
        "other"
      ],
      "title": "PlaceCategory",
      "type": "string"
    },
    "PointsPipeline": {
      "additionalProperties": false,
      "description": "Point facilities with projected coordinates -> place_master.",
      "properties": {
        "active_values": {
          "items": {
            "type": "string"
          },
          "title": "Active Values",
          "type": "array"
        },
        "attribute_columns": {
          "items": {
            "type": "string"
          },
          "title": "Attribute Columns",
          "type": "array"
        },
        "category": {
          "$ref": "#/$defs/PlaceCategory"
        },
        "crs": {
          "default": "EPSG:25830",
          "pattern": "^EPSG:\\d{4,5}$",
          "title": "Crs",
          "type": "string"
        },
        "csv": {
          "$ref": "#/$defs/CsvFormat"
        },
        "dataset_id": {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "title": "Dataset Id",
          "type": "string"
        },
        "group_by_id": {
          "default": false,
          "title": "Group By Id",
          "type": "boolean"
        },
        "grouped_list_columns": {
          "items": {
            "type": "string"
          },
          "title": "Grouped List Columns",
          "type": "array"
        },
        "id_column": {
          "title": "Id Column",
          "type": "string"
        },
        "kind": {
          "const": "points_csv",
          "title": "Kind",
          "type": "string"
        },
        "municipio_code_column": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Municipio Code Column"
        },
        "name_column": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name Column"
        },
        "name_template": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name Template"
        },
        "resource_role": {
          "default": "primary",
          "title": "Resource Role",
          "type": "string"
        },
        "row_filters": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Row Filters",
          "type": "object"
        },
        "status_column": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status Column"
        },
        "subcategory_column": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subcategory Column"
        },
        "subcategory_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subcategory Value"
        },
        "x_column": {
          "title": "X Column",
          "type": "string"
        },
        "y_column": {
          "title": "Y Column",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "dataset_id",
        "category",
        "id_column",
        "x_column",
        "y_column"
      ],
      "title": "PointsPipeline",
      "type": "object"
    },
    "TerritoryLevel": {
      "description": "Territorial units observations can refer to (superset of AdminLevel).",
      "enum": [
        "ccaa",
        "municipio",
        "distrito",
        "barrio",
        "seccion_censal",
        "codigo_postal",
        "zona_estadistica",
        "h3_r8",
        "h3_r9"
      ],
      "title": "TerritoryLevel",
      "type": "string"
    }
  },
  "$id": "https://housing-intelligence/schemas/pipeline.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "discriminator": {
    "mapping": {
      "cm_postcode_concept": "#/$defs/CmPostcodeConceptPipeline",
      "cm_stat_table": "#/$defs/CmStatTablePipeline",
      "gtfs_feed": "#/$defs/GtfsFeedPipeline",
      "madrid_padron": "#/$defs/MadridPadronPipeline",
      "osm_walk_network": "#/$defs/OsmWalkNetworkPipeline",
      "points_csv": "#/$defs/PointsPipeline"
    },
    "propertyName": "kind"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/CmStatTablePipeline"
    },
    {
      "$ref": "#/$defs/CmPostcodeConceptPipeline"
    },
    {
      "$ref": "#/$defs/MadridPadronPipeline"
    },
    {
      "$ref": "#/$defs/PointsPipeline"
    },
    {
      "$ref": "#/$defs/GtfsFeedPipeline"
    },
    {
      "$ref": "#/$defs/OsmWalkNetworkPipeline"
    }
  ]
}

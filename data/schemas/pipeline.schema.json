{
  "$defs": {
    "AeatRentComparisonPipeline": {
      "additionalProperties": false,
      "description": "Agencia Tributaria, «Estadística de viviendas declaradas en IRPF»: the HTML table that\ncompares the mean monthly rent and the mean m² of all leases with those of the leases\nsigned in the year («nuevos contratos»), by municipio or by postcode (D-228).\n\nRows look like «Alcalá de Henares-28005» (municipio) or «28001-Salamanca- Goya» (postcode);\nthe first two numeric columns are the rents (all, new) and the next two the m² (all, new).\nOnly the rows of the province in `province_prefix` are kept; the region's own row\n(«Madrid, Comunidad de») becomes the ccaa observation.",
      "properties": {
        "area_metric_id": {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "title": "Area Metric Id",
          "type": "string"
        },
        "contract_dim": {
          "default": "contratos",
          "title": "Contract Dim",
          "type": "string"
        },
        "dataset_id": {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "title": "Dataset Id",
          "type": "string"
        },
        "kind": {
          "const": "aeat_rent_comparison",
          "title": "Kind",
          "type": "string"
        },
        "level": {
          "enum": [
            "municipio",
            "codigo_postal"
          ],
          "title": "Level",
          "type": "string"
        },
        "max_rows": {
          "exclusiveMinimum": 0,
          "title": "Max Rows",
          "type": "integer"
        },
        "min_rows": {
          "description": "fewer rows in scope -> the table changed or is cut",
          "exclusiveMinimum": 0,
          "title": "Min Rows",
          "type": "integer"
        },
        "province_prefix": {
          "pattern": "^\\d{2}$",
          "title": "Province Prefix",
          "type": "string"
        },
        "region_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Row of the region, e.g. «Madrid, Comunidad de» (municipio table only: in the postcode table it only adds up the municipios that have postcodes)",
          "title": "Region Label"
        },
        "rent_metric_id": {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "title": "Rent Metric Id",
          "type": "string"
        },
        "resource_role": {
          "default": "primary",
          "title": "Resource Role",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "dataset_id",
        "level",
        "rent_metric_id",
        "area_metric_id",
        "province_prefix",
        "min_rows",
        "max_rows"
      ],
      "title": "AeatRentComparisonPipeline",
      "type": "object"
    },
    "CmMunicipioConceptPipeline": {
      "additionalProperties": false,
      "description": "Instituto de Estadística tables without a territory code (D-235): the municipio comes\nby name and what the row counts is in a free-text 'Concepto' column.\n\nOnly the rows whose concept starts with `concept_prefix` are read. The source writes the\nnames by hand (double spaces, «Rozas de Madrid»), so `municipios` maps each spelling to its\nINE code after collapsing the whitespace; a name that is not there goes to quarantine and\nfails the run, never dropped in silence. Rows whose status is in `excluded_statuses` (e.g.\n«Provisional») are left out and counted.",
      "properties": {
        "concept_column": {
          "default": "Concepto",
          "title": "Concept Column",
          "type": "string"
        },
        "concept_prefix": {
          "minLength": 1,
          "title": "Concept Prefix",
          "type": "string"
        },
        "csv": {
          "$ref": "#/$defs/CsvFormat"
        },
        "dataset_id": {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "title": "Dataset Id",
          "type": "string"
        },
        "excluded_statuses": {
          "items": {
            "type": "string"
          },
          "title": "Excluded Statuses",
          "type": "array"
        },
        "expected_municipios": {
          "description": "municipios the table publishes",
          "exclusiveMinimum": 0,
          "title": "Expected Municipios",
          "type": "integer"
        },
        "kind": {
          "const": "cm_municipio_concept",
          "title": "Kind",
          "type": "string"
        },
        "metric_id": {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "title": "Metric Id",
          "type": "string"
        },
        "missing_markers": {
          "items": {
            "type": "string"
          },
          "title": "Missing Markers",
          "type": "array"
        },
        "municipio_column": {
          "default": "Municipio",
          "title": "Municipio Column",
          "type": "string"
        },
        "municipios": {
          "additionalProperties": {
            "pattern": "^28\\d{3}$",
            "type": "string"
          },
          "minProperties": 1,
          "title": "Municipios",
          "type": "object"
        },
        "period_column": {
          "default": "Año",
          "title": "Period Column",
          "type": "string"
        },
        "resource_role": {
          "default": "primary",
          "title": "Resource Role",
          "type": "string"
        },
        "status_column": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "Estado dato",
          "title": "Status Column"
        },
        "unit_column": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "Unidad",
          "title": "Unit Column"
        },
        "value_column": {
          "default": "Valor",
          "title": "Value Column",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "dataset_id",
        "metric_id",
        "concept_prefix",
        "municipios",
        "expected_municipios"
      ],
      "title": "CmMunicipioConceptPipeline",
      "type": "object"
    },
    "CmPostcodeConceptPipeline": {
      "additionalProperties": false,
      "description": "Tables where the postcode is embedded in a free-text 'Concepto' column.",
      "properties": {
        "concept_column": {
          "default": "Concepto",
          "title": "Concept Column",
          "type": "string"
        },
        "csv": {
          "$ref": "#/$defs/CsvFormat"
        },
        "dataset_id": {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "title": "Dataset Id",
          "type": "string"
        },
        "kind": {
          "const": "cm_postcode_concept",
          "title": "Kind",
          "type": "string"
        },
        "metric_id": {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "title": "Metric Id",
          "type": "string"
        },
        "missing_markers": {
          "items": {
            "type": "string"
          },
          "title": "Missing Markers",
          "type": "array"
        },
        "period_column": {
          "default": "Año",
          "title": "Period Column",
          "type": "string"
        },
        "postcode_pattern": {
          "default": "c[oó]digo postal (\\d{5})",
          "title": "Postcode Pattern",
          "type": "string"
        },
        "resource_role": {
          "default": "primary",
          "title": "Resource Role",
          "type": "string"
        },
        "value_column": {
          "default": "Valor",
          "title": "Value Column",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "dataset_id",
        "metric_id"
      ],
      "title": "CmPostcodeConceptPipeline",
      "type": "object"
    },
    "CmStatTablePipeline": {
      "additionalProperties": false,
      "description": "Instituto de Estadística long tables: Año | Tipo territorio | Código | ... | Valor.",
      "properties": {
        "csv": {
          "$ref": "#/$defs/CsvFormat"
        },
        "dataset_id": {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "title": "Dataset Id",
          "type": "string"
        },
        "dimension_columns": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Dimension Columns",
          "type": "object"
        },
        "kind": {
          "const": "cm_stat_table",
          "title": "Kind",
          "type": "string"
        },
        "metric_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{2,95}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Metric Id"
        },
        "metric_split": {
          "anyOf": [
            {
              "$ref": "#/$defs/MetricSplit"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "missing_markers": {
          "items": {
            "type": "string"
          },
          "title": "Missing Markers",
          "type": "array"
        },
        "period_column": {
          "default": "Año",
          "title": "Period Column",
          "type": "string"
        },
        "period_min": {
          "anyOf": [
            {
              "maximum": 2100,
              "minimum": 1900,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Period Min"
        },
        "resource_role": {
          "default": "primary",
          "title": "Resource Role",
          "type": "string"
        },
        "territory_code_column": {
          "default": "Código territorio",
          "title": "Territory Code Column",
          "type": "string"
        },
        "territory_name_column": {
          "default": "Territorio",
          "title": "Territory Name Column",
          "type": "string"
        },
        "territory_type_column": {
          "default": "Tipo territorio",
          "title": "Territory Type Column",
          "type": "string"
        },
        "territory_types": {
          "additionalProperties": {
            "$ref": "#/$defs/TerritoryLevel"
          },
          "title": "Territory Types",
          "type": "object"
        },
        "unit_column": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "Unidad",
          "title": "Unit Column"
        },
        "value_column": {
          "default": "Valor",
          "title": "Value Column",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "dataset_id",
        "territory_types"
      ],
      "title": "CmStatTablePipeline",
      "type": "object"
    },
    "CsvFormat": {
      "additionalProperties": false,
      "properties": {
        "decimal": {
          "default": ".",
          "title": "Decimal",
          "type": "string"
        },
        "encodings": {
          "items": {
            "type": "string"
          },
          "title": "Encodings",
          "type": "array"
        },
        "separator": {
          "default": ";",
          "title": "Separator",
          "type": "string"
        }
      },
      "title": "CsvFormat",
      "type": "object"
    },
    "DirectoryLink": {
      "additionalProperties": false,
      "description": "A register's places are matched against an official directory to take its name and\ncapacity (D-218). Only the declared subcategories are matched.",
      "properties": {
        "dataset_id": {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "title": "Dataset Id",
          "type": "string"
        },
        "kinds": {
          "additionalProperties": {
            "type": "string"
          },
          "minProperties": 1,
          "title": "Kinds",
          "type": "object"
        },
        "name_prefix": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Name Prefix",
          "type": "object"
        }
      },
      "required": [
        "dataset_id",
        "kinds"
      ],
      "title": "DirectoryLink",
      "type": "object"
    },
    "FacilityDirectoryPipeline": {
      "additionalProperties": false,
      "description": "An official directory of facilities (one XLSX sheet) kept in Silver only (D-218).\n\nIt never creates places: the register's own pipeline matches its places against the\ndirectory (entity resolution with a declared method) to take the institutional name and the\npublished capacity. Contact columns (phone, email) are never read.",
      "properties": {
        "address_column": {
          "title": "Address Column",
          "type": "string"
        },
        "capacity_column": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Capacity Column"
        },
        "capacity_unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Capacity Unit"
        },
        "dataset_id": {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "title": "Dataset Id",
          "type": "string"
        },
        "dependency_column": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dependency Column"
        },
        "id_column": {
          "title": "Id Column",
          "type": "string"
        },
        "kind": {
          "const": "facility_directory",
          "title": "Kind",
          "type": "string"
        },
        "kind_column": {
          "title": "Kind Column",
          "type": "string"
        },
        "max_rows": {
          "exclusiveMinimum": 0,
          "title": "Max Rows",
          "type": "integer"
        },
        "min_rows": {
          "description": "fewer rows in scope -> the sheet changed or is cut",
          "exclusiveMinimum": 0,
          "title": "Min Rows",
          "type": "integer"
        },
        "municipality_column": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Municipality Column"
        },
        "name_column": {
          "title": "Name Column",
          "type": "string"
        },
        "postal_code_column": {
          "title": "Postal Code Column",
          "type": "string"
        },
        "resource_role": {
          "default": "primary",
          "title": "Resource Role",
          "type": "string"
        },
        "scope_column": {
          "title": "Scope Column",
          "type": "string"
        },
        "scope_values": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Scope Values",
          "type": "array"
        },
        "sheet": {
          "title": "Sheet",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "dataset_id",
        "sheet",
        "id_column",
        "name_column",
        "address_column",
        "postal_code_column",
        "kind_column",
        "scope_column",
        "scope_values",
        "min_rows",
        "max_rows"
      ],
      "title": "FacilityDirectoryPipeline",
      "type": "object"
    },
    "GtfsFeedPipeline": {
      "additionalProperties": false,
      "description": "Static GTFS feed -> one transport place per stop or parent station, with service levels.\n\nService is measured on one reference day: the median (by active trips) of the feed's\n`reference_weekday` dates inside its own validity window, so the result never depends on\nthe day the pipeline runs.",
      "properties": {
        "dataset_id": {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "title": "Dataset Id",
          "type": "string"
        },
        "expand_frequencies": {
          "default": true,
          "description": "False when frequencies.txt only annotates trips already listed one by one",
          "title": "Expand Frequencies",
          "type": "boolean"
        },
        "kind": {
          "const": "gtfs_feed",
          "title": "Kind",
          "type": "string"
        },
        "mode": {
          "description": "place subcategory, e.g. metro, emt",
          "pattern": "^[a-z_]+$",
          "title": "Mode",
          "type": "string"
        },
        "peak_end": {
          "default": "09:00",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
          "title": "Peak End",
          "type": "string"
        },
        "peak_start": {
          "default": "07:00",
          "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
          "title": "Peak Start",
          "type": "string"
        },
        "reference_weekday": {
          "default": "tuesday",
          "enum": [
            "monday",
            "tuesday",
            "wednesday",
            "thursday",
            "friday",
            "saturday",
            "sunday"
          ],
          "title": "Reference Weekday",
          "type": "string"
        },
        "resource_role": {
          "default": "primary",
          "title": "Resource Role",
          "type": "string"
        },
        "station_accessibility": {
          "anyOf": [
            {
              "$ref": "#/$defs/StationAccessibilityLink"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "kind",
        "dataset_id",
        "mode"
      ],
      "title": "GtfsFeedPipeline",
      "type": "object"
    },
    "MadridDistrictPanelPipeline": {
      "additionalProperties": false,
      "description": "Ayuntamiento de Madrid district panel: one row per indicator, territory and panel year.\n\nOnly the declared indicators are kept, at district level. A barrio row is kept, at barrio\nlevel and with the barrio's name, only for the indicators in `barrio_indicators` (D-232:\nthe official barrio names come from here); the city row only for those in\n`city_indicators` (then it is the municipio, the value to compare the districts with).\nEvery reference date is kept once: when two panel editions carry the same date, the latest\nedition wins (a revision).",
      "properties": {
        "barrio_column": {
          "default": "cod_barrio",
          "title": "Barrio Column",
          "type": "string"
        },
        "barrio_indicators": {
          "items": {
            "type": "string"
          },
          "title": "Barrio Indicators",
          "type": "array"
        },
        "barrio_name_column": {
          "default": "barrio",
          "title": "Barrio Name Column",
          "type": "string"
        },
        "city_indicators": {
          "items": {
            "type": "string"
          },
          "title": "City Indicators",
          "type": "array"
        },
        "csv": {
          "$ref": "#/$defs/CsvFormat"
        },
        "dataset_id": {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "title": "Dataset Id",
          "type": "string"
        },
        "district_column": {
          "default": "cod_distrito",
          "title": "District Column",
          "type": "string"
        },
        "district_name_column": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "distrito",
          "title": "District Name Column"
        },
        "edition_column": {
          "default": "Periodo panel",
          "title": "Edition Column",
          "type": "string"
        },
        "expected_barrios": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Barrios"
        },
        "expected_districts": {
          "exclusiveMinimum": 0,
          "title": "Expected Districts",
          "type": "integer"
        },
        "indicator_column": {
          "default": "indicador_completo",
          "title": "Indicator Column",
          "type": "string"
        },
        "indicators": {
          "additionalProperties": {
            "pattern": "^[a-z][a-z0-9_]{2,95}$",
            "type": "string"
          },
          "minProperties": 1,
          "title": "Indicators",
          "type": "object"
        },
        "kind": {
          "const": "madrid_district_panel",
          "title": "Kind",
          "type": "string"
        },
        "missing_markers": {
          "items": {
            "type": "string"
          },
          "title": "Missing Markers",
          "type": "array"
        },
        "municipio_ine": {
          "pattern": "^28\\d{3}$",
          "title": "Municipio Ine",
          "type": "string"
        },
        "period_column": {
          "default": "fecha_indicador",
          "title": "Period Column",
          "type": "string"
        },
        "resource_role": {
          "default": "primary",
          "title": "Resource Role",
          "type": "string"
        },
        "unit_column": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "unidad_indicador",
          "title": "Unit Column"
        },
        "value_column": {
          "default": "valor_indicador",
          "title": "Value Column",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "dataset_id",
        "municipio_ine",
        "indicators",
        "expected_districts"
      ],
      "title": "MadridDistrictPanelPipeline",
      "type": "object"
    },
    "MadridPadronPipeline": {
      "additionalProperties": false,
      "description": "Ayuntamiento de Madrid padrón: one row per census section and single year of age.\n\nDistricts get the CM census 5-year age bands plus their total, so ratios over this\npopulation compare like with like. The count columns (nationality x sex) are only summed.",
      "properties": {
        "age_column": {
          "title": "Age Column",
          "type": "string"
        },
        "census_metric_id": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]{2,95}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Census Metric Id"
        },
        "count_columns": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Count Columns",
          "type": "array"
        },
        "csv": {
          "$ref": "#/$defs/CsvFormat"
        },
        "dataset_id": {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "title": "Dataset Id",
          "type": "string"
        },
        "district_column": {
          "title": "District Column",
          "type": "string"
        },
        "district_name_column": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "District Name Column"
        },
        "expected_districts": {
          "exclusiveMinimum": 0,
          "title": "Expected Districts",
          "type": "integer"
        },
        "kind": {
          "const": "madrid_padron",
          "title": "Kind",
          "type": "string"
        },
        "metric_id": {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "title": "Metric Id",
          "type": "string"
        },
        "municipio_ine": {
          "pattern": "^28\\d{3}$",
          "title": "Municipio Ine",
          "type": "string"
        },
        "period_column": {
          "title": "Period Column",
          "type": "string"
        },
        "resource_role": {
          "default": "primary",
          "title": "Resource Role",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "dataset_id",
        "metric_id",
        "municipio_ine",
        "district_column",
        "age_column",
        "count_columns",
        "period_column",
        "expected_districts"
      ],
      "title": "MadridPadronPipeline",
      "type": "object"
    },
    "MetricSplit": {
      "additionalProperties": false,
      "description": "One source column decides which metric a row belongs to (e.g. 'Medida').",
      "properties": {
        "column": {
          "title": "Column",
          "type": "string"
        },
        "metrics": {
          "additionalProperties": {
            "pattern": "^[a-z][a-z0-9_]{2,95}$",
            "type": "string"
          },
          "title": "Metrics",
          "type": "object"
        }
      },
      "required": [
        "column",
        "metrics"
      ],
      "title": "MetricSplit",
      "type": "object"
    },
    "OsmParksPipeline": {
      "additionalProperties": false,
      "description": "OpenStreetMap extract -> public parks as places (DATA-018, D-222).\n\nA park is an area tagged with one of `leisure` that is not closed to the public and has at\nleast `min_area_ha`. Each becomes a place (a point inside it) that also keeps the points of\nits edge every `edge_step_m` metres: walking access is measured to the edge, not the centre.",
      "properties": {
        "access_denied": {
          "items": {
            "type": "string"
          },
          "title": "Access Denied",
          "type": "array"
        },
        "dataset_id": {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "title": "Dataset Id",
          "type": "string"
        },
        "edge_step_m": {
          "default": 50.0,
          "exclusiveMinimum": 0,
          "title": "Edge Step M",
          "type": "number"
        },
        "kind": {
          "const": "osm_parks",
          "title": "Kind",
          "type": "string"
        },
        "leisure": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Leisure",
          "type": "array"
        },
        "max_parks": {
          "exclusiveMinimum": 0,
          "title": "Max Parks",
          "type": "integer"
        },
        "min_area_ha": {
          "exclusiveMinimum": 0,
          "title": "Min Area Ha",
          "type": "number"
        },
        "min_parks": {
          "description": "below this the extract is truncated",
          "exclusiveMinimum": 0,
          "title": "Min Parks",
          "type": "integer"
        },
        "resource_role": {
          "default": "primary",
          "title": "Resource Role",
          "type": "string"
        },
        "subcategory": {
          "default": "Parque",
          "title": "Subcategory",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "dataset_id",
        "min_area_ha",
        "min_parks",
        "max_parks"
      ],
      "title": "OsmParksPipeline",
      "type": "object"
    },
    "OsmWalkNetworkPipeline": {
      "additionalProperties": false,
      "description": "OpenStreetMap extract -> undirected walkable street graph, kept in Silver only.\n\nA way is walkable when its `highway` value is listed or it explicitly allows people on foot;\n`foot=no`, or `access=no/private` without a foot permission, removes it. One-way rules apply\nto vehicles, so the graph is undirected. Only indicators computed on it reach the database.",
      "properties": {
        "access_denied": {
          "items": {
            "type": "string"
          },
          "title": "Access Denied",
          "type": "array"
        },
        "dataset_id": {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "title": "Dataset Id",
          "type": "string"
        },
        "foot_allowed": {
          "items": {
            "type": "string"
          },
          "title": "Foot Allowed",
          "type": "array"
        },
        "kind": {
          "const": "osm_walk_network",
          "title": "Kind",
          "type": "string"
        },
        "min_main_component_share": {
          "default": 0.9,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Min Main Component Share",
          "type": "number"
        },
        "min_total_km": {
          "description": "below this the extract is truncated",
          "exclusiveMinimum": 0,
          "title": "Min Total Km",
          "type": "number"
        },
        "resource_role": {
          "default": "primary",
          "title": "Resource Role",
          "type": "string"
        },
        "walkable_highways": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Walkable Highways",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "dataset_id",
        "walkable_highways",
        "min_total_km"
      ],
      "title": "OsmWalkNetworkPipeline",
      "type": "object"
    },
    "PlaceCategory": {
      "enum": [
        "education",
        "health",
        "pharmacy",
        "social",
        "transport",
        "commerce",
        "culture",
        "sport",
        "administration",
        "green",
        "other"
      ],
      "title": "PlaceCategory",
      "type": "string"
    },
    "PointsPipeline": {
      "additionalProperties": false,
      "description": "Point facilities with projected coordinates -> place_master.",
      "properties": {
        "active_values": {
          "items": {
            "type": "string"
          },
          "title": "Active Values",
          "type": "array"
        },
        "address_number_column": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Address Number Column"
        },
        "address_street_column": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Address Street Column"
        },
        "address_template": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Address Template"
        },
        "attribute_columns": {
          "items": {
            "type": "string"
          },
          "title": "Attribute Columns",
          "type": "array"
        },
        "category": {
          "$ref": "#/$defs/PlaceCategory"
        },
        "crs": {
          "default": "EPSG:25830",
          "pattern": "^EPSG:\\d{4,5}$",
          "title": "Crs",
          "type": "string"
        },
        "csv": {
          "$ref": "#/$defs/CsvFormat"
        },
        "dataset_id": {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "title": "Dataset Id",
          "type": "string"
        },
        "dependency_column": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dependency Column"
        },
        "directories": {
          "items": {
            "$ref": "#/$defs/DirectoryLink"
          },
          "title": "Directories",
          "type": "array"
        },
        "district_code_column": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "District Code Column"
        },
        "group_by_id": {
          "default": false,
          "title": "Group By Id",
          "type": "boolean"
        },
        "grouped_list_columns": {
          "items": {
            "type": "string"
          },
          "title": "Grouped List Columns",
          "type": "array"
        },
        "id_column": {
          "title": "Id Column",
          "type": "string"
        },
        "kind": {
          "const": "points_csv",
          "title": "Kind",
          "type": "string"
        },
        "municipio_code_column": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Municipio Code Column"
        },
        "municipio_name_column": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Municipio Name Column"
        },
        "name_column": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name Column"
        },
        "name_template": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name Template"
        },
        "postal_code_column": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Postal Code Column"
        },
        "resource_role": {
          "default": "primary",
          "title": "Resource Role",
          "type": "string"
        },
        "row_filters": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Row Filters",
          "type": "object"
        },
        "status_column": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status Column"
        },
        "subcategory_column": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subcategory Column"
        },
        "subcategory_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subcategory Value"
        },
        "x_column": {
          "title": "X Column",
          "type": "string"
        },
        "y_column": {
          "title": "Y Column",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "dataset_id",
        "category",
        "id_column",
        "x_column",
        "y_column"
      ],
      "title": "PointsPipeline",
      "type": "object"
    },
    "StationAccessibilityLink": {
      "additionalProperties": false,
      "description": "A GTFS feed's stations take their accessibility from a station topology (D-223). The key\nof a stop is group 1 of `stop_id_pattern`, compared with the topology's `match` column.",
      "properties": {
        "dataset_id": {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "title": "Dataset Id",
          "type": "string"
        },
        "match": {
          "enum": [
            "station_id",
            "operator_code"
          ],
          "title": "Match",
          "type": "string"
        },
        "stop_id_pattern": {
          "title": "Stop Id Pattern",
          "type": "string"
        }
      },
      "required": [
        "dataset_id",
        "match",
        "stop_id_pattern"
      ],
      "title": "StationAccessibilityLink",
      "type": "object"
    },
    "StationTopologyPipeline": {
      "additionalProperties": false,
      "description": "A network topology layer of the CRTM (one station per row, ArcGIS JSON) kept in Silver\nonly (DATA-019, D-223). It never creates places: a GTFS feed that declares it takes from it\nhow accessible each of its stations is, matched by an official code.\n\n`step_free` reads the published accessibility grade: every grade the layer may carry is\ndeclared with its reading (yes, partial or no); a grade that is not declared is quarantined.",
      "properties": {
        "dataset_id": {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "title": "Dataset Id",
          "type": "string"
        },
        "grade_field": {
          "title": "Grade Field",
          "type": "string"
        },
        "id_field": {
          "title": "Id Field",
          "type": "string"
        },
        "kind": {
          "const": "station_topology",
          "title": "Kind",
          "type": "string"
        },
        "max_rows": {
          "exclusiveMinimum": 0,
          "title": "Max Rows",
          "type": "integer"
        },
        "min_rows": {
          "description": "fewer stations -> the layer changed or is cut",
          "exclusiveMinimum": 0,
          "title": "Min Rows",
          "type": "integer"
        },
        "name_field": {
          "title": "Name Field",
          "type": "string"
        },
        "operator_code_field": {
          "title": "Operator Code Field",
          "type": "string"
        },
        "resource_role": {
          "default": "primary",
          "title": "Resource Role",
          "type": "string"
        },
        "step_free": {
          "additionalProperties": {
            "enum": [
              "yes",
              "partial",
              "no"
            ],
            "type": "string"
          },
          "minProperties": 1,
          "title": "Step Free",
          "type": "object"
        }
      },
      "required": [
        "kind",
        "dataset_id",
        "id_field",
        "operator_code_field",
        "name_field",
        "grade_field",
        "step_free",
        "min_rows",
        "max_rows"
      ],
      "title": "StationTopologyPipeline",
      "type": "object"
    },
    "TerritoryLevel": {
      "description": "Territorial units observations can refer to (superset of AdminLevel).",
      "enum": [
        "ccaa",
        "municipio",
        "distrito",
        "barrio",
        "seccion_censal",
        "codigo_postal",
        "zona_estadistica",
        "h3_r8",
        "h3_r9"
      ],
      "title": "TerritoryLevel",
      "type": "string"
    }
  },

        },
        "yield_land": {
          "anyOf": [
            {
              "enum": [
                "precio",
                "valor_residual"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "The land the yield counts: the price given, or without one the residual land value (paying the most the target margin allows); never no land",
          "title": "Yield Land"
        }

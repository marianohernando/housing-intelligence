          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Annual rent over construction plus land; null without rent or when not even free land reaches the target margin",
          "title": "Rental Yield Pct"
        },
        "residual_land_value": {
          "title": "Residual Land Value",
          "type": "number"
        },
        "residual_land_value_m2": {
          "title": "Residual Land Value M2",
          "type": "number"
        },
        "revenue": {
          "title": "Revenue",
          "type": "number"
        },
        "sales_costs": {
          "title": "Sales Costs",
          "type": "number"
        },
        "total_cost": {

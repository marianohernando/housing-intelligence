{
  "$defs": {
    "DatasetRef": {
      "additionalProperties": false,
      "description": "Provenance of a result: the dataset, who publishes it and where to open it.",
      "properties": {
        "attribution_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "What the licence asks to show next to the data (source, date, geocoder)",
          "title": "Attribution Text"
        },
        "dataset_id": {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "title": "Dataset Id",
          "type": "string"
        },
        "is_cm_open_data": {
          "description": "Published in the Comunidad de Madrid open data portal (counts for DATAMAD)",
          "title": "Is Cm Open Data",
          "type": "boolean"
        },
        "license": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "publisher": {
          "title": "Publisher",
          "type": "string"
        },
        "source_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Where it is published, to name where `url` opens (the CM portal, the Ayuntamiento's, OpenStreetMap, the Ministerio de Sanidad, the Agencia Tributaria…)",
          "examples": [
            "Portal de Datos Abiertos del Ayuntamiento de Madrid"
          ],
          "title": "Source Name"
        },
        "url": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Portal page (CM portal when it exists)",
          "title": "Url"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "dataset_version label used",
          "title": "Version"
        }
      },
      "required": [
        "dataset_id",
        "name",
        "publisher",
        "is_cm_open_data"
      ],
      "title": "DatasetRef",
      "type": "object"
    },
    "GapCount": {
      "additionalProperties": false,
      "properties": {
        "falta": {
          "minimum": 0,
          "title": "Falta",
          "type": "integer"
        },
        "justo": {
          "minimum": 0,
          "title": "Justo",
          "type": "integer"
        },
        "rows": {
          "description": "Labels of the FALTA rows, then the JUSTO ones",
          "items": {
            "type": "string"
          },
          "title": "Rows",
          "type": "array"
        }
      },
      "required": [
        "falta",
        "justo",
        "rows"
      ],
      "title": "GapCount",
      "type": "object"
    },
    "InvestorZoneList": {
      "additionalProperties": false,
      "properties": {
        "datasets": {
          "items": {
            "$ref": "#/$defs/DatasetRef"
          },
          "title": "Datasets",
          "type": "array"
        },
        "pilot": {
          "examples": [
            "Madrid capital dentro de la M-40"
          ],
          "title": "Pilot",
          "type": "string"
        },
        "zones": {
          "items": {
            "$ref": "#/$defs/InvestorZoneSummary"
          },
          "title": "Zones",
          "type": "array"
        }
      },
      "required": [
        "pilot",
        "zones",
        "datasets"
      ],
      "title": "InvestorZoneList",
      "type": "object"
    },
    "InvestorZoneSummary": {
      "additionalProperties": false,
      "description": "A pilot barrio in the list: what it lacks (its district's rows), its land and prices.",
      "properties": {
        "commerce_per_1000": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Open local shops per 1.000 inhabitants (line A); null until loaded",
          "title": "Commerce Per 1000"
        },
        "district": {
          "$ref": "#/$defs/ZoneRef"
        },
        "gaps": {
          "anyOf": [
            {
              "$ref": "#/$defs/GapCount"
            },
            {
              "type": "null"
            }
          ],
          "description": "Its district's «Qué falta»; null if not computed"
        },
        "parcels": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Public parcels for housing; null if unknown",
          "title": "Parcels"
        },
        "parcels_m2": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Parcels M2"
        },
        "remaining_m2": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Residential buildable area left in its planning areas (line A); null until loaded. An area that also covers other barrios counts whole here",
          "title": "Remaining M2"
        },
        "remaining_shared_areas": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "How many of those areas also cover other barrios",
          "title": "Remaining Shared Areas"
        },
        "rent_m2_month": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Rent M2 Month"
        },
        "sale_price_m2": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Sale Price M2"
        },
        "zone": {
          "$ref": "#/$defs/ZoneRef"
        }
      },
      "required": [
        "zone",
        "district",
        "gaps",
        "parcels",
        "parcels_m2",
        "remaining_m2",
        "commerce_per_1000",
        "sale_price_m2",
        "rent_m2_month"
      ],
      "title": "InvestorZoneSummary",
      "type": "object"
    },
    "Meta": {
      "properties": {
        "api_version": {
          "default": "v1",
          "title": "Api Version",
          "type": "string"
        },
        "data_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Data Version"
        },
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "methodology_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Methodology Version"
        },
        "request_id": {
          "title": "Request Id",
          "type": "string"
        }
      },
      "title": "Meta",
      "type": "object"
    },
    "TerritoryLevel": {
      "description": "Territorial units observations can refer to (superset of AdminLevel).",
      "enum": [
        "ccaa",
        "municipio",
        "distrito",
        "barrio",
        "seccion_censal",
        "codigo_postal",
        "zona_estadistica",
        "h3_r8",
        "h3_r9"
      ],
      "title": "TerritoryLevel",
      "type": "string"
    },
    "ZoneRef": {
      "additionalProperties": false,
      "description": "A zone the product talks about. `code` is the INE code (municipio, sección) or H3 index.",
      "properties": {
        "admin_unit_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "geo_admin_unit id for /api/v1/geo/admin-units; None for H3 cells",
          "examples": [
            "ES.28.MUN.28079"
          ],
          "title": "Admin Unit Id"
        },
        "center_lat": {
          "anyOf": [
            {
              "maximum": 41.17,
              "minimum": 39.88,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Center Lat"
        },
        "center_lon": {
          "anyOf": [
            {
              "maximum": -3.05,
              "minimum": -4.58,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Center Lon"
        },
        "code": {
          "examples": [
            "28079",
            "2807901124"
          ],
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "level": {
          "$ref": "#/$defs/TerritoryLevel"
        },
        "municipio_ine": {
          "anyOf": [
            {
              "pattern": "^28\\d{3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Municipio Ine"
        },
        "municipio_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Municipio Name"
        },
        "name": {
          "examples": [
            "Madrid"
          ],
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "level",
        "code",
        "name"
      ],
      "title": "ZoneRef",
      "type": "object"
    }
  },
  "$id": "https://housing-intelligence/schemas/api/investor_zone_list_response.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "GET /api/v1/investors/zones (D-248)",
  "properties": {
    "data": {
      "$ref": "#/$defs/InvestorZoneList"
    },
    "meta": {
      "$ref": "#/$defs/Meta"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "data"
  ],
  "title": "InvestorZoneListResponse",
  "type": "object"
}

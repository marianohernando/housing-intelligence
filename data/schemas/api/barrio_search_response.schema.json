{
  "$defs": {
    "Anchor": {
      "additionalProperties": false,
      "description": "A place the household travels to often: where they work, or family and friends.",
      "properties": {
        "days_per_week": {
          "default": 5,
          "description": "Days they go there in a week: 1-2 halve the weight of the trip; 0 = never (full telework), the trip is not scored but its max_minutes still applies (D-240)",
          "maximum": 7,
          "minimum": 0,
          "title": "Days Per Week",
          "type": "integer"
        },
        "kind": {
          "$ref": "#/$defs/AnchorKind",
          "default": "work"
        },
        "label": {
          "examples": [
            "Paseo de la Castellana (Azca)"
          ],
          "maxLength": 80,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "lat": {
          "maximum": 41.17,
          "minimum": 39.88,
          "title": "Lat",
          "type": "number"
        },
        "lon": {
          "maximum": -3.05,
          "minimum": -4.58,
          "title": "Lon",
          "type": "number"
        },
        "max_minutes": {
          "anyOf": [
            {
              "maximum": 120,
              "minimum": 5,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Hard limit for the trip; None = preference only",
          "title": "Max Minutes"
        }
      },
      "required": [
        "label",
        "lon",
        "lat"
      ],
      "title": "Anchor",
      "type": "object"
    },
    "AnchorKind": {
      "enum": [
        "work",
        "study",
        "family",
        "other"
      ],
      "title": "AnchorKind",
      "type": "string"
    },
    "BarrioSearchResult": {
      "additionalProperties": false,
      "description": "The barrios of one Madrid district ranked by the same engine as POST /search (D-232):\nthe same conditions, % of fit, facts, near misses and Reality Check, with barrios as zones.\n`gap_highlights` stay empty: «Qué falta» is by district (GET /gaps/distrito/{code}).",
      "properties": {
        "all_zones": {
          "description": "Every evaluated zone, for the map",
          "items": {
            "$ref": "#/$defs/ZoneMatch"
          },
          "title": "All Zones",
          "type": "array"
        },
        "datasets": {
          "description": "Every dataset behind this result",
          "items": {
            "$ref": "#/$defs/DatasetRef"
          },
          "title": "Datasets",
          "type": "array"
        },
        "distrito": {
          "$ref": "#/$defs/ZoneRef"
        },
        "methodology_version": {
          "title": "Methodology Version",
          "type": "string"
        },
        "near_misses": {
          "description": "Explicit alternatives failing one condition",
          "items": {
            "$ref": "#/$defs/RankedZone"
          },
          "title": "Near Misses",
          "type": "array"
        },
        "reality_check": {
          "$ref": "#/$defs/RealityCheck"
        },
        "results": {
          "description": "Zones passing every constraint, best first",
          "items": {
            "$ref": "#/$defs/RankedZone"
          },
          "title": "Results",
          "type": "array"
        },
        "scenario": {
          "$ref": "#/$defs/ScenarioState"
        }
      },
      "required": [
        "scenario",
        "results",
        "all_zones",
        "reality_check",
        "datasets",
        "methodology_version",
        "distrito"
      ],
      "title": "BarrioSearchResult",
      "type": "object"
    },
    "Budget": {
      "additionalProperties": false,
      "description": "Rent in €/month or purchase price in €; the purchase result is always «orientativo».",
      "properties": {
        "amount_eur": {
          "description": "€/month when kind=rent, € when kind=buy",
          "exclusiveMinimum": 0,
          "title": "Amount Eur",
          "type": "integer"
        },
        "kind": {
          "$ref": "#/$defs/BudgetKind"
        }
      },
      "required": [
        "kind",
        "amount_eur"
      ],
      "title": "Budget",
      "type": "object"
    },
    "BudgetKind": {
      "enum": [
        "rent",
        "buy"
      ],
      "title": "BudgetKind",
      "type": "string"
    },
    "ConstraintCheck": {
      "additionalProperties": false,
      "description": "One hard condition of the scenario evaluated on one zone.",
      "properties": {
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "constraint_id": {
          "examples": [
            "budget",
            "near:colegio",
            "commute:0"
          ],
          "pattern": "^(budget|near:[a-z_]+|commute:\\d)$",
          "title": "Constraint Id",
          "type": "string"
        },
        "explanation": {
          "examples": [
            "Un piso de 90 m² cuesta unos 1.420 €/mes aquí"
          ],
          "title": "Explanation",
          "type": "string"
        },
        "label": {
          "examples": [
            "Alquiler hasta 1.500 €/mes"
          ],
          "title": "Label",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ConstraintStatus"
        },
        "threshold": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Threshold"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "constraint_id",
        "label",
        "status",
        "confidence",
        "explanation"
      ],
      "title": "ConstraintCheck",
      "type": "object"
    },
    "ConstraintStatus": {
      "enum": [
        "PASS",
        "FAIL",
        "UNKNOWN"
      ],
      "title": "ConstraintStatus",
      "type": "string"
    },
    "DatasetRef": {
      "additionalProperties": false,
      "description": "Provenance of a result: the dataset, who publishes it and where to open it.",
      "properties": {
        "attribution_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "What the licence asks to show next to the data (source, date, geocoder)",
          "title": "Attribution Text"
        },
        "dataset_id": {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "title": "Dataset Id",
          "type": "string"
        },
        "is_cm_open_data": {
          "description": "Published in the Comunidad de Madrid open data portal (counts for DATAMAD)",
          "title": "Is Cm Open Data",
          "type": "boolean"
        },
        "license": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "publisher": {
          "title": "Publisher",
          "type": "string"
        },
        "source_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Where it is published, to name where `url` opens (the CM portal, the Ayuntamiento's, OpenStreetMap, the Ministerio de Sanidad, the Agencia Tributaria…)",
          "examples": [
            "Portal de Datos Abiertos del Ayuntamiento de Madrid"
          ],
          "title": "Source Name"
        },
        "url": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Portal page (CM portal when it exists)",
          "title": "Url"
        },
        "version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "dataset_version label used",
          "title": "Version"
        }
      },
      "required": [
        "dataset_id",
        "name",
        "publisher",
        "is_cm_open_data"
      ],
      "title": "DatasetRef",
      "type": "object"
    },
    "Fact": {
      "additionalProperties": false,
      "description": "A tangible, plain-language fact («Colegio público a 6 min andando») with its confidence,\nalways traceable to an indicator and its datasets.",
      "properties": {
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "indicator": {
          "anyOf": [
            {
              "$ref": "#/$defs/IndicatorValue"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "kind": {
          "$ref": "#/$defs/FactKind"
        },
        "text": {
          "examples": [
            "Colegio con primaria a unos 6 min andando"
          ],
          "title": "Text",
          "type": "string"
        },
        "topic": {
          "$ref": "#/$defs/FactTopic"
        }
      },
      "required": [
        "kind",
        "topic",
        "text",
        "confidence"
      ],
      "title": "Fact",
      "type": "object"
    },
    "FactKind": {
      "enum": [
        "strength",
        "weakness",
        "unknown"
      ],
      "title": "FactKind",
      "type": "string"
    },
    "FactTopic": {
      "description": "Which icon the web shows next to a fact.",
      "enum": [
        "coste",
        "transporte",
        "salud",
        "colegios",
        "zonas_verdes",
        "seguridad",
        "accesibilidad",
        "trayecto",
        "otro"
      ],
      "title": "FactTopic",
      "type": "string"
    },
    "GapHighlight": {
      "additionalProperties": false,
      "description": "One row of «Qué falta aquí» for the zone card; the full list is GET /gaps.",
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "row": {
          "$ref": "#/$defs/GapRowKey"
        },
        "status": {
          "$ref": "#/$defs/GapStatus"
        }
      },
      "required": [
        "row",
        "label",
        "status"
      ],
      "title": "GapHighlight",
      "type": "object"
    },
    "GapRowKey": {
      "description": "Rows of the per-zone list of what is missing (GAP-001, D-194).",
      "enum": [
        "escuela_infantil",
        "colegio",
        "centro_salud",
        "mayores",
        "farmacia",
        "vivienda"
      ],
      "title": "GapRowKey",
      "type": "string"
    },
    "GapStatus": {
      "enum": [
        "FALTA",
        "JUSTO",
        "CUBIERTO",
        "SIN_DATOS"
      ],
      "title": "GapStatus",
      "type": "string"
    },
    "Household": {
      "additionalProperties": false,
      "description": "«Tu hogar»: adults, children and older people they look after (all live together).",
      "properties": {
        "adults": {
          "default": 1,
          "maximum": 8,
          "minimum": 1,
          "title": "Adults",
          "type": "integer"
        },
        "minor_ages": {
          "description": "0-17, optional",
          "items": {
            "type": "integer"
          },
          "title": "Minor Ages",
          "type": "array"
        },
        "minors": {
          "default": 0,
          "maximum": 8,
          "minimum": 0,
          "title": "Minors",
          "type": "integer"
        },
        "seniors_in_care": {
          "default": 0,
          "description": "People aged 65+ cared for",
          "maximum": 4,
          "minimum": 0,
          "title": "Seniors In Care",
          "type": "integer"
        }
      },
      "title": "Household",
      "type": "object"
    },
    "IndicatorValue": {
      "additionalProperties": false,
      "description": "One measured value with its unit, confidence and the reason when it is missing.",
      "properties": {
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "datasets": {
          "description": "dataset_id values",
          "items": {
            "type": "string"
          },
          "title": "Datasets",
          "type": "array"
        },
        "feature_id": {
          "title": "Feature Id",
          "type": "string"
        },
        "label": {
          "description": "Plain-language name",
          "title": "Label",
          "type": "string"
        },
        "level": {
          "$ref": "#/$defs/TerritoryLevel",
          "description": "Level the value was computed at"
        },
        "null_reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/NullReason"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Why value is missing; never 0 for unknown"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "feature_id",
        "label",
        "value",
        "unit",
        "confidence",
        "level"
      ],
      "title": "IndicatorValue",
      "type": "object"
    },
    "Meta": {
      "properties": {
        "api_version": {
          "default": "v1",
          "title": "Api Version",
          "type": "string"
        },
        "data_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Data Version"
        },
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "methodology_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Methodology Version"
        },
        "request_id": {
          "title": "Request Id",
          "type": "string"
        }
      },
      "title": "Meta",
      "type": "object"
    },
    "NearbyNeed": {
      "additionalProperties": false,
      "description": "A service the household wants within walking distance (e.g. «colegio cerca»).",
      "properties": {
        "max_walk_minutes": {
          "default": 10,
          "maximum": 60,
          "minimum": 1,
          "title": "Max Walk Minutes",
          "type": "integer"
        },
        "need": {
          "$ref": "#/$defs/NeedKey"
        },
        "required": {
          "default": true,
          "description": "True = hard constraint (PASS/FAIL/UNKNOWN)",
          "title": "Required",
          "type": "boolean"
        }
      },
      "required": [
        "need"
      ],
      "title": "NearbyNeed",
      "type": "object"
    },
    "NeedKey": {
      "description": "Everyday services the search and the per-zone list both talk about.",
      "enum": [
        "escuela_infantil",
        "colegio",
        "centro_salud",
        "farmacia",
        "mayores",
        "transporte"
      ],
      "title": "NeedKey",
      "type": "string"
    },
    "NullReason": {
      "enum": [
        "NOT_APPLICABLE",
        "SOURCE_NO_COVERAGE",
        "SOURCE_MISSING",
        "TEMPORARILY_UNAVAILABLE",
        "STALE",
        "PARSE_ERROR",
        "ENTITY_NOT_RESOLVED",
        "ESTIMATION_NOT_ALLOWED",
        "UNKNOWN"
      ],
      "title": "NullReason",
      "type": "string"
    },
    "PriorityKey": {
      "description": "«Me importa» chips. Seguridad only counts when chosen; sin escaleras is optional.",
      "enum": [
        "transporte",
        "salud",
        "colegios",
        "zonas_verdes",
        "seguridad",
        "sin_escaleras"
      ],
      "title": "PriorityKey",
      "type": "string"
    },
    "RankedZone": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "constraints": {
          "items": {
            "$ref": "#/$defs/ConstraintCheck"
          },
          "title": "Constraints",
          "type": "array"
        },
        "estimated_cost_eur": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Monthly rent or purchase price for the needed area",
          "title": "Estimated Cost Eur"
        },
        "facts": {
          "description": "Up to 5 tangible facts, most important to the person first; unknown last",
          "items": {
            "$ref": "#/$defs/Fact"
          },
          "maxItems": 5,
          "title": "Facts",
          "type": "array"
        },
        "failed_constraints": {
          "description": "constraint_id values with FAIL (near misses)",
          "items": {
            "type": "string"
          },
          "title": "Failed Constraints",
          "type": "array"
        },
        "gap_highlights": {
          "items": {
            "$ref": "#/$defs/GapHighlight"
          },
          "maxItems": 3,
          "title": "Gap Highlights",
          "type": "array"
        },
        "match_pct": {
          "description": "% of fit with the search, not a grade",
          "maximum": 100,
          "minimum": 0,
          "title": "Match Pct",
          "type": "integer"
        },
        "rank": {
          "minimum": 1,
          "title": "Rank",
          "type": "integer"
        },
        "zone": {
          "$ref": "#/$defs/ZoneRef"
        }
      },
      "required": [
        "rank",
        "zone",
        "match_pct",
        "confidence",
        "facts",
        "constraints"
      ],
      "title": "RankedZone",
      "type": "object"
    },
    "RealityCheck": {
      "additionalProperties": false,
      "properties": {
        "binding_constraint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "constraint_id that removes the most zones",
          "title": "Binding Constraint"
        },
        "relaxations": {
          "description": "Sorted by added_zones, largest first",
          "items": {
            "$ref": "#/$defs/Relaxation"
          },
          "title": "Relaxations",
          "type": "array"
        },
        "zones_evaluated": {
          "minimum": 0,
          "title": "Zones Evaluated",
          "type": "integer"
        },
        "zones_passing": {
          "description": "Every constraint PASS",
          "minimum": 0,
          "title": "Zones Passing",
          "type": "integer"
        },
        "zones_unknown": {
          "description": "No FAIL but some UNKNOWN: not counted as passing",
          "minimum": 0,
          "title": "Zones Unknown",
          "type": "integer"
        }
      },
      "required": [
        "zones_evaluated",
        "zones_passing",
        "zones_unknown",
        "relaxations"
      ],
      "title": "RealityCheck",
      "type": "object"
    },
    "Relaxation": {
      "additionalProperties": false,
      "description": "How many more zones appear when one condition is relaxed and the rest stay.\n\n`relaxed_scenario` is the scenario with that change applied: the web sends it back to\nPOST /search when the person taps the option.",
      "properties": {
        "added_zones": {
          "minimum": 0,
          "title": "Added Zones",
          "type": "integer"
        },
        "constraint_id": {
          "title": "Constraint Id",
          "type": "string"
        },
        "label": {
          "examples": [
            "+100 €/mes",
            "+10 min de trayecto"
          ],
          "title": "Label",
          "type": "string"
        },
        "relaxed_scenario": {
          "$ref": "#/$defs/ScenarioState"
        },
        "zones_if_relaxed": {
          "minimum": 0,
          "title": "Zones If Relaxed",
          "type": "integer"
        }
      },
      "required": [
        "constraint_id",
        "label",
        "zones_if_relaxed",
        "added_zones",
        "relaxed_scenario"
      ],
      "title": "Relaxation",
      "type": "object"
    },
    "ScenarioState": {
      "additionalProperties": false,
      "properties": {
        "anchors": {
          "items": {
            "$ref": "#/$defs/Anchor"
          },
          "maxItems": 3,
          "title": "Anchors",
          "type": "array"
        },
        "budget": {
          "anyOf": [
            {
              "$ref": "#/$defs/Budget"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "None = no budget limit"
        },
        "household": {
          "$ref": "#/$defs/Household"
        },
        "min_floor_area_m2": {
          "anyOf": [
            {
              "maximum": 400,
              "minimum": 15,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "None = derived from the household size",
          "title": "Min Floor Area M2"
        },
        "nearby": {
          "items": {
            "$ref": "#/$defs/NearbyNeed"
          },
          "maxItems": 6,
          "title": "Nearby",
          "type": "array"
        },
        "priorities": {
          "description": "Most important first",
          "items": {
            "$ref": "#/$defs/PriorityKey"
          },
          "maxItems": 6,
          "title": "Priorities",
          "type": "array"
        },
        "schema_version": {
          "const": 2,
          "default": 2,
          "title": "Schema Version",
          "type": "integer"
        },
        "scope": {
          "$ref": "#/$defs/SearchScope",
          "default": "all",
          "description": "Where to search; Madrid capital is ranked by barrio instead of by district"
        }
      },
      "title": "ScenarioState",
      "type": "object"
    },
    "SearchScope": {
      "description": "«Dónde buscar» (D-238): the whole region, or one of its three parts by the statistical\nzoning of the Comunidad de Madrid (data/catalog/zoning/search_scope.yaml).",
      "enum": [
        "all",
        "madrid",
        "alrededores",
        "pueblos"
      ],
      "title": "SearchScope",
      "type": "string"
    },
    "TerritoryLevel": {
      "description": "Territorial units observations can refer to (superset of AdminLevel).",
      "enum": [
        "ccaa",
        "municipio",
        "distrito",
        "barrio",
        "seccion_censal",
        "codigo_postal",
        "zona_estadistica",
        "h3_r8",
        "h3_r9"
      ],
      "title": "TerritoryLevel",
      "type": "string"
    },
    "ZoneMatch": {
      "additionalProperties": false,
      "description": "Every evaluated zone, for the choropleth («Encaje con tu búsqueda»).",
      "properties": {
        "failed_constraints": {
          "items": {
            "type": "string"
          },
          "title": "Failed Constraints",
          "type": "array"
        },
        "match_pct": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "None = unknown",
          "title": "Match Pct"
        },
        "passes_all": {
          "title": "Passes All",
          "type": "boolean"
        },
        "zone": {
          "$ref": "#/$defs/ZoneRef"
        }
      },
      "required": [
        "zone",
        "passes_all"
      ],
      "title": "ZoneMatch",
      "type": "object"
    },
    "ZoneRef": {
      "additionalProperties": false,
      "description": "A zone the product talks about. `code` is the INE code (municipio, sección) or H3 index.",
      "properties": {
        "admin_unit_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "geo_admin_unit id for /api/v1/geo/admin-units; None for H3 cells",
          "examples": [
            "ES.28.MUN.28079"
          ],
          "title": "Admin Unit Id"
        },
        "center_lat": {
          "anyOf": [
            {
              "maximum": 41.17,
              "minimum": 39.88,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Center Lat"
        },
        "center_lon": {
          "anyOf": [
            {
              "maximum": -3.05,
              "minimum": -4.58,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Center Lon"
        },
        "code": {
          "examples": [
            "28079",
            "2807901124"
          ],
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "level": {
          "$ref": "#/$defs/TerritoryLevel"
        },
        "municipio_ine": {
          "anyOf": [
            {
              "pattern": "^28\\d{3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Municipio Ine"
        },
        "municipio_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Municipio Name"
        },
        "name": {
          "examples": [
            "Madrid"
          ],
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "level",
        "code",
        "name"
      ],
      "title": "ZoneRef",
      "type": "object"
    }
  },

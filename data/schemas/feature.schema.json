{
  "$defs": {
    "Domain": {
      "enum": [
        "housing",
        "population",
        "income",
        "education",
        "health",
        "social",
        "transport",
        "urbanism",
        "environment",
        "economy",
        "employment",
        "safety",
        "geography",
        "other"
      ],
      "title": "Domain",
      "type": "string"
    },
    "FeatureConfidence": {
      "additionalProperties": false,
      "properties": {
        "inputs": {
          "items": {
            "type": "string"
          },
          "title": "Inputs",
          "type": "array"
        }
      },
      "title": "FeatureConfidence",
      "type": "object"
    },
    "FeatureFormula": {
      "additionalProperties": true,
      "properties": {
        "method": {
          "title": "Method",
          "type": "string"
        }
      },
      "required": [
        "method"
      ],
      "title": "FeatureFormula",
      "type": "object"
    },
    "FeatureSource": {
      "additionalProperties": false,
      "properties": {
        "dataset_id": {
          "pattern": "^[a-z][a-z0-9_]{2,95}$",
          "title": "Dataset Id",
          "type": "string"
        },
        "levels": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/GeoResolution"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Levels whose computation uses this dataset (the feature's geo_level or a key of formula.levels); None means every level. Each row cites only its own.",
          "title": "Levels"
        },
        "role": {
          "default": "primary",
          "enum": [
            "primary",
            "secondary",
            "denominator",
            "validation"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "dataset_id"
      ],
      "title": "FeatureSource",
      "type": "object"
    },
    "FitBinding": {
      "additionalProperties": false,
      "description": "Where the people search (CORE-003) reads the feature: the rent or the appraised purchase\nvalue per m² of the budget condition (D-227; `estimate` marks an estimated one, D-234), or\nthe walking minutes to the nearest place of a kind, either a service (a ScenarioState\nNeedKey) or what a «me importa» priority measures (a PriorityKey: the park for «Zonas\nverdes», D-222), or the walk to one kind of public transport (`transit_mode`, D-233): it\nonly informs the transport fact and never scores. The search has no feature id written in\nits code.",
      "properties": {
        "estimate": {
          "default": false,
          "description": "Only for price_m2: the figure is an estimate, not a published price (D-234: the city's appraised value shared out by cadastral value). The search uses it where no published price exists and says so",
          "title": "Estimate",
          "type": "boolean"
        },
        "mode": {
          "anyOf": [
            {
              "enum": [
                "bus",
                "metro"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Kind of stop the walk is to, only for transit_mode (D-233)",
          "title": "Mode"
        },
        "need": {
          "anyOf": [
            {
              "pattern": "^[a-z_]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "NeedKey, only for walk_minutes",
          "title": "Need"
        },
        "note": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "What the cost figure is, in the fact the search writes («contratos firmados en 2024; …», D-228); only for rent_m2. It travels with the data, so code and data never disagree on what the number means",
          "title": "Note"
        },
        "priority": {
          "anyOf": [
            {
              "pattern": "^[a-z_]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "PriorityKey, only for walk_minutes",
          "title": "Priority"
        },
        "role": {
          "enum": [
            "rent_m2",
            "price_m2",
            "walk_minutes",
            "transit_mode"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "role"
      ],
      "title": "FitBinding",
      "type": "object"
    },
    "GapRowBinding": {
      "additionalProperties": false,
      "description": "Where the feature shows up in the per-zone list (GAP-001): the row's main indicator,\nor an extra one next to it (e.g. walking minutes).",
      "properties": {
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Row title; required for primary",
          "title": "Label"
        },
        "phrase": {
          "description": "Unit in words, e.g. 'colegios por cada 1.000 menores'",
          "title": "Phrase",
          "type": "string"
        },
        "proxy_note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "What the indicator does not measure",
          "title": "Proxy Note"
        },
        "role": {
          "default": "primary",
          "enum": [
            "primary",
            "extra"
          ],
          "title": "Role",
          "type": "string"
        },
        "row": {
          "$ref": "#/$defs/GapRowKey"
        }
      },
      "required": [
        "row",
        "phrase"
      ],
      "title": "GapRowBinding",
      "type": "object"
    },
    "GapRowKey": {
      "description": "Rows of the per-zone list of what is missing (GAP-001, D-194).",
      "enum": [
        "escuela_infantil",
        "colegio",
        "centro_salud",
        "mayores",
        "farmacia",
        "vivienda"
      ],
      "title": "GapRowKey",
      "type": "string"
    },
    "GeoResolution": {
      "enum": [
        "ccaa",
        "provincia",
        "municipio",
        "distrito",
        "barrio",
        "seccion_censal",
        "codigo_postal",
        "h3",
        "parcela",
        "edificio",
        "point",
        "line",
        "none",
        "unknown"
      ],
      "title": "GeoResolution",
      "type": "string"
    },
    "H3JoinMethod": {
      "enum": [
        "centroid",
        "overlap",
        "population_weighted",
        "network_access"
      ],
      "title": "H3JoinMethod",
      "type": "string"
    },
    "NullPolicy": {
      "additionalProperties": false,
      "properties": {
        "confirmed_zero": {
          "default": 0,
          "enum": [
            0,
            "unknown"
          ],
          "title": "Confirmed Zero"
        },
        "no_coverage": {
          "default": "unknown",
          "enum": [
            "unknown",
            "not_applicable"
          ],
          "title": "No Coverage",
          "type": "string"
        }
      },
      "title": "NullPolicy",
      "type": "object"
    }
  },
  "$id": "https://housing-intelligence/schemas/feature.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "confidence": {
      "$ref": "#/$defs/FeatureConfidence"
    },
    "direction": {
      "enum": [
        "higher_is_better",
        "lower_is_better",
        "neutral",
        "target_range"
      ],
      "title": "Direction",
      "type": "string"
    },
    "domain": {
      "$ref": "#/$defs/Domain"
    },
    "feature_id": {
      "pattern": "^[a-z][a-z0-9_]{2,95}$",
      "title": "Feature Id",
      "type": "string"
    },
    "fit": {
      "anyOf": [
        {
          "$ref": "#/$defs/FitBinding"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "formula": {
      "$ref": "#/$defs/FeatureFormula"
    },
    "gap_row": {
      "anyOf": [
        {
          "$ref": "#/$defs/GapRowBinding"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "geo_level": {
      "$ref": "#/$defs/GeoResolution"
    },
    "h3_join_method": {
      "anyOf": [
        {
          "$ref": "#/$defs/H3JoinMethod"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "human_name": {
      "title": "Human Name",
      "type": "string"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "models": {
      "items": {
        "type": "string"
      },
      "title": "Models",
      "type": "array"
    },
    "null_policy": {
      "$ref": "#/$defs/NullPolicy"
    },
    "pro_use": {
      "default": false,
      "title": "Pro Use",
      "type": "boolean"
    },
    "public_use": {
      "default": false,
      "title": "Public Use",
      "type": "boolean"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/FeatureSource"
      },
      "minItems": 1,
      "title": "Sources",
      "type": "array"
    },
    "tests": {
      "items": {
        "type": "string"
      },
      "title": "Tests",
      "type": "array"
    },
    "time_semantics": {
      "enum": [
        "current",
        "snapshot",
        "period",
        "forecast",
        "scenario"
      ],
      "title": "Time Semantics",
      "type": "string"
    },
    "type": {
      "enum": [
        "raw",
        "derived",
        "aggregate",
        "model_output"
      ],
      "title": "Type",
      "type": "string"
    },
    "unit": {
      "title": "Unit",
      "type": "string"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "feature_id",
    "version",
    "human_name",
    "domain",
    "type",
    "unit",
    "direction",
    "geo_level",
    "time_semantics",
    "sources",
    "formula"
  ],
  "title": "FeatureSpec",
  "type": "object"
}
